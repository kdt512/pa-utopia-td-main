{
  "buildPlatform": "web-mobile",
  "orientation": "portrait",
  "extName": "UTD_PA6_TapToUpgrade_",
  "exportChannels": [
    "Mintegral",
    "AppLovin",
    "Facebook",
    "Unity",
    "Google",
    "Tiktok"
  ],
  "injectOptions": {
    "AppLovin": {
      "head": "<script>function mraidOpenPlayStore(){mraid.open('https://play.google.com/store/apps/details?id=com.av.voxelshooter&hl=en');}function mraidOpenAppStore(id){mraid.open('https://apps.apple.com/us/app/voxel-shooter/id6779878307');}</script>"
    },
    "Unity": {
      "body": "<script>function mraidOpenPlayStore(){mraid.open('https://play.google.com/store/apps/details?id=com.av.voxelshooter&hl=en');}function mraidOpenAppStore(id){mraid.open('https://apps.apple.com/us/app/voxel-shooter/id6779878307');}</script>",
      "sdkScript": "<script src=\"./mraid.js\"></script>"
    }
  }
}